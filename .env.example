# LightOmation Configurator — environment overrides
# Copy this file to .env and edit before running `docker compose up`.
#
# ⚠️  PORT CONFLICTS — read if you have other Docker apps running
# ─────────────────────────────────────────────────────────────────
# The defaults below (8000 / 3000) will fail with "port already allocated"
# if another container is using those ports.
#
# Fix: change BACKEND_PORT and/or FRONTEND_PORT to any free port, e.g.
#
#   BACKEND_PORT=8001
#   FRONTEND_PORT=3001
#
# Then access the app at:
#   Frontend → http://localhost:<FRONTEND_PORT>
#   API      → http://localhost:<BACKEND_PORT>
# ─────────────────────────────────────────────────────────────────

# Backend
BACKEND_PORT=8000
DATABASE_PATH=/data/lightomation.db
ENVIRONMENT=development

# Frontend
FRONTEND_PORT=3000

# NOTE: CORS_ORIGINS and VITE_API_BASE_URL are derived from the ports above
# inside docker-compose.yml — you do not need to set them here.
